{
  "manifest_version": 3,
  "name": "3SVerse LinkedIn Campaign Uploader",
  "version": "1.2.0",
  "description": "Schedule one day-matched LinkedIn company-page image or video post per day with complete captions and hashtags.",
  "permissions": ["storage", "tabs", "scripting", "debugger", "unlimitedStorage"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Open 3SVerse LinkedIn Campaign Uploader",
    "default_icon": { "16": "brand/icon-16.png", "48": "brand/icon-48.png", "128": "brand/icon-128.png" }
  },
  "icons": { "16": "brand/icon-16.png", "48": "brand/icon-48.png", "128": "brand/icon-128.png" },
  "content_scripts": [{
    "matches": ["https://www.linkedin.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
